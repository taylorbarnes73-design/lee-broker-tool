PORT=3000
DATABASE_URL=
DATABASE_SSL_MODE=disabled
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret
# Required in production (NODE_ENV=production) for broker tool /auth.login and session cookies.
ADMIN_EMAIL=_NewportBeach-BrokerAdmin@lee-associates.com
MARKETING_EMAIL=fperkins@lee-associates.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONNECTOR_API_KEY=replace-with-a-long-random-shared-secret

# Local broker auth
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_EMAIL_DOMAIN=lee-associates.com
# Local sign-in accepts either a full Lee email or the username before @lee-associates.com.
#
# Admin role is granted when any of these match (see server/auth/isAdminByPolicy.ts):
# - LOCAL_ADMIN_EMAILS (comma-separated emails or Lee usernames)
# - LOCAL_ADMIN_NAMES (comma-separated display names, case-insensitive)
# - Broker directory entries with title "Office Admin"
LOCAL_ADMIN_EMAILS=
LOCAL_ADMIN_NAMES=

# Sign-request emails CC this address (vendor / print partner).
CIMARRON_EMAIL=

# Canonical browser origin for links in notification emails (fallback: request Host).
APP_URL=

# Current custom OAuth portal used by this app's login flow
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_ENABLE_AUTH_REDIRECT=false

# Public app id passed to the frontend login URL and server-side session payloads
VITE_APP_ID=

# Optional: only if the browser origin is NOT the same host as the API (unusual for leebrokertool.com).
# Production normally leaves this empty so requests stay same-origin (e.g. https://leebrokertool.com/api/...).
# Example separate API host: https://api.example.com
VITE_API_BASE_URL=

# Canonical browser origin for admin invite emails (fallback: request Host). Production: https://leebrokertool.com
PUBLIC_APP_URL=

# AES-256-GCM key for app_settings secrets (Dealius credentials). Base64-encoded 32 bytes, or any string (hashed to 32 bytes).
SETTINGS_ENCRYPTION_KEY=
# Optional: force Dealius settings connection test to fail (development only).
# SETTINGS_DEALIUS_TEST_STUB=fail

# Managed service proxy used by current storage / AI helpers
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google Maps / Places API key — used server-side for address autocomplete and street view proxy.
# Enable Maps JavaScript API, Places API, and Street View Static API in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Anthropic API key — preferred for document parsing (lease PDFs, voucher uploads, contract intake).
# Claude reads PDFs/images directly and is tried first when this key is set.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google AI direct API key — fallback for document parsing when Anthropic is unavailable.
# Also used as the primary LLM backend for text-only AI features when Forge/OpenAI are not set.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key (fallback when neither Forge nor Gemini is configured).
# NOTE: o-series models (o1, o3, o4-mini) are automatically detected and use
# max_completion_tokens + developer role to satisfy their API requirements.
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Quick convert: full path to LibreOffice soffice for Word→PDF and letterhead (default: search PATH).
# Docker/ECS image sets /usr/bin/soffice; on macOS use the LibreOffice.app bundle path if needed.
QUICK_CONVERT_SOFFICE_PATH=

# Dealius integration (server-to-server; no local proxy required)
DEALIUS_BASE_URL=https://leenewportbeach.dealius.com
DEALIUS_EMAIL=
DEALIUS_PASSWORD=
# Optional: path to Dealius **Users** export (.xlsx) or JSON array — enriches broker name → ContactID resolution on deal push
# DEALIUS_USERS_DIRECTORY=C:\\path\\to\\users_export.xlsx

# AWS target state for auth
AWS_REGION=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_DOMAIN=

# AWS target state for storage
AWS_S3_BUCKET=
AWS_S3_REGION=
