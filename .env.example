PORT=3000
DATABASE_URL=
DATABASE_SSL_MODE=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret
# Required in production (NODE_ENV=production) for broker tool /auth.login and session cookies.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONNECTOR_API_KEY=replace-with-a-long-random-shared-secret

# Local broker auth
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_EMAIL_DOMAIN=lee-associates.com
# Local sign-in accepts either a full Lee email or the username before @lee-associates.com.
#
# Admin role is fixed in code to exactly these two names (case-insensitive):
# - Errissa Kat
# - Taylor Barnes

# Current custom OAuth portal used by this app's login flow
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_ENABLE_AUTH_REDIRECT=false

# Public app id passed to the frontend login URL and server-side session payloads
VITE_APP_ID=

# Optional: only if the browser origin is NOT the same host as the API (unusual for leebrokertool.com).
# Production normally leaves this empty so requests stay same-origin (e.g. https://leebrokertool.com/api/...).
# Example separate API host: https://api.example.com
VITE_API_BASE_URL=

# Canonical browser origin for admin invite emails (fallback: request Host). Production: https://leebrokertool.com
PUBLIC_APP_URL=

# AES-256-GCM key for app_settings secrets (Dealius credentials). Base64-encoded 32 bytes, or any string (hashed to 32 bytes).
SETTINGS_ENCRYPTION_KEY=
# Optional: force Dealius settings connection test to fail (development only).
# SETTINGS_DEALIUS_TEST_STUB=fail

# Managed service proxy used by current storage / AI helpers
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google Maps / Places API key — used server-side for address autocomplete and street view proxy.
# Enable Maps JavaScript API, Places API, and Street View Static API in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Google AI direct API key — second-priority LLM backend when Forge is not configured.
# Also used for native PDF/image understanding in file-upload parsing (best quality).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key (used when neither Forge nor Google AI is configured)
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Dealius integration (server-to-server; no local proxy required)
DEALIUS_BASE_URL=https://leenewportbeach.dealius.com
DEALIUS_EMAIL=
DEALIUS_PASSWORD=
# Optional: path to Dealius **Users** export (.xlsx) or JSON array — enriches broker name → ContactID resolution on deal push
# DEALIUS_USERS_DIRECTORY=C:\\path\\to\\users_export.xlsx

# AWS target state for auth
AWS_REGION=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_DOMAIN=

# AWS target state for storage
AWS_S3_BUCKET=
AWS_S3_REGION=
